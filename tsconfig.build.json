{
  "extends": "@tsconfig/node24/tsconfig.json",

  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",

    "stripInternal": true,
    "sourceMap": true
